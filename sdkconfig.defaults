# The connected development hardware was detected as an ESP32-S3.
CONFIG_IDF_TARGET="esp32s3"

# Use the board's native USB Serial/JTAG connection for the interactive console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Use the ESP32-S3-optimized ESP-DSP implementation with only the FFT size
# required by the acoustic analysis component.
CONFIG_DSP_OPTIMIZED=y
CONFIG_DSP_MAX_FFT_SIZE_2048=y
